{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Fullstack Platform (Client + Server)",
      "dependsOn": [
        "Backend Server (Port 5000)",
        "Frontend Vite (Port 5173)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Backend Server (Port 5000)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*TravelTest Backend running.*"
        }
      },
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Frontend Vite (Port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Network:.*|.*Local:.*"
        }
      },
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run All Playwright Tests (38 Scenarios)",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Open Playwright Test UI Inspector",
      "type": "shell",
      "command": "npx playwright test --ui",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Install All Dependencies",
      "type": "shell",
      "command": "npm run install:all",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}